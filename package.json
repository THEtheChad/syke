{
  "name": "@thethechad/syke",
  "version": "0.0.0-semantically-released",
  "description": "Stream utilities for memory-bound work, for Node.js streams (@thethechad/syke/node) and Web Streams (@thethechad/syke/web).",
  "keywords": [
    "stream",
    "streams",
    "web streams",
    "backpressure",
    "spool",
    "spill to disk",
    "checksum",
    "digest",
    "length",
    "duplex",
    "transform",
    "memory"
  ],
  "author": "Chad Elliott <chad.d.elliott@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/THEtheChad/syke#readme",
  "bugs": "https://github.com/THEtheChad/syke/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THEtheChad/syke.git"
  },
  "type": "module",
  "exports": {
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc -p test/consumer",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm build && node scripts/test-browser.mjs",
    "lint:package": "publint && attw --pack . --profile node16 && node scripts/check-web-bundle.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm typecheck:dist && pnpm lint:package",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "fake-indexeddb": "^6.2.6",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
